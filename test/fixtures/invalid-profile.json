{
  "schemaVersion": "1",
  "tool": "opencode",
  "imageName": "codecapsule/opencode:latest",
  "stateVolume": "codecapsule-opencode-state",
  "cacheVolume": "codecapsule-opencode-cache",
  "security": {
    "allowPrivileged": true,
    "allowDockerSocket": true,
    "allowHostHomeMount": false,
    "allowSshAgent": false,
    "envAllowlist": ["TERM"]
  }
}
