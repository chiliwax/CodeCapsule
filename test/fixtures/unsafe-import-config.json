{
  "schemaVersion": "1",
  "tool": "opencode",
  "imageName": "codecapsule/opencode:latest",
  "containerWorkdir": "/workspace",
  "opencodeVersion": "latest",
  "statePath": ".codecapsule/state/opencode",
  "cachePath": ".codecapsule/cache/opencode",
  "configPath": ".codecapsule/config/opencode",
  "network": "bridge",
  "imports": {
    "settings": true,
    "auth": true,
    "skills": true,
    "plugins": false,
    "agents": false,
    "commands": false,
    "tools": false,
    "themes": false
  },
  "security": {
    "allowPrivileged": true,
    "allowDockerSocket": true,
    "allowHostHomeMount": true,
    "allowSshAgent": true,
    "envAllowlist": ["TERM", "SSH_AUTH_SOCK"]
  }
}
